meta {
  name: Upload Archivo
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/upload
  body: multipart-form
  auth: none
}

body:multipart-form {
  file: @file(../../data/samples/ejemplo_planograma.csv)
}

script:post-response {
  // Guarda el file_id en la variable de entorno para las siguientes requests
  if (res.status === 200) {
    bru.setVar("file_id", res.body.file_id);
    console.log("file_id capturado:", res.body.file_id);
    console.log("Configuraciones detectadas:", res.body.configuraciones.length);
  }
}
